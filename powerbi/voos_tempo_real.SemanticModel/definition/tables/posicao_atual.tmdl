table posicao_atual
	lineageTag: 7bca9278-951e-49f9-b3a7-c38b98af6116

	measure 'Ultima Coleta' = CALCULATE ( MAX ( posicao_atual[coleta_brt] ), REMOVEFILTERS ( posicao_atual ) )
		formatString: dd/MM/yyyy HH:mm:ss
		displayFolder: Base
		lineageTag: 4339ebde-716f-4322-a8aa-04ddc3698053

	measure 'Avioes No Ar' =
			CALCULATE (
			    COUNTROWS ( posicao_atual ),
			    REMOVEFILTERS ( posicao_atual ),
			    posicao_atual[em_solo] = FALSE ()
			)
		formatString: #,0
		displayFolder: Base
		lineageTag: ab341780-4fac-4c5e-aae7-d25285f4cb2a

	measure 'Avioes Em Solo' =
			CALCULATE (
			    COUNTROWS ( posicao_atual ),
			    REMOVEFILTERS ( posicao_atual ),
			    posicao_atual[em_solo] = TRUE ()
			)
		formatString: #,0
		displayFolder: Base
		lineageTag: 9c2046f6-8758-4999-a8e1-97f4ae59a27e

	measure 'Velocidade Media No Ar' =
			CALCULATE (
			    AVERAGE ( posicao_atual[velocidade_kmh] ),
			    REMOVEFILTERS ( posicao_atual ),
			    posicao_atual[em_solo] = FALSE ()
			)
		formatString: #,0
		displayFolder: Base
		lineageTag: 6ab0bd5e-8a7b-4be5-90ea-abd598e1a354

	measure 'Altitude Media No Ar' =
			CALCULATE (
			    AVERAGE ( posicao_atual[altitude_m] ),
			    REMOVEFILTERS ( posicao_atual ),
			    posicao_atual[em_solo] = FALSE ()
			)
		formatString: #,0
		displayFolder: Base
		lineageTag: 6b31a1ed-741d-4025-bdbe-cbc8ff35f47b

	measure 'Companhias No Ar' =
			CALCULATE (
			    DISTINCTCOUNT ( posicao_atual[companhia] ),
			    REMOVEFILTERS ( posicao_atual ),
			    posicao_atual[em_solo] = FALSE (),
			    posicao_atual[tipo_companhia] IN { "Nacional", "Internacional", "Carga" }
			)
		formatString: #,0
		displayFolder: Base
		lineageTag: e43be5a3-4922-4fdc-9b8e-f196388afa34

	measure 'Avioes No Ar Ontem' =
			VAR _alvo = [Ultima Coleta] - 1
			VAR _coleta =
			    CALCULATE (
			        MAX ( resumo_coleta[coleta_brt] ),
			        REMOVEFILTERS ( resumo_coleta ),
			        resumo_coleta[coleta_brt] <= _alvo,
			        resumo_coleta[coleta_brt] > _alvo - 15 / 1440
			    )
			RETURN
			    IF (
			        NOT ISBLANK ( _coleta ),
			        CALCULATE (
			            SUM ( resumo_coleta[no_ar] ),
			            REMOVEFILTERS ( resumo_coleta ),
			            resumo_coleta[coleta_brt] = _coleta
			        )
			    )
		formatString: #,0
		displayFolder: Base
		lineageTag: a8c01551-ffcc-4f88-b043-e0d121b60f28

	measure 'Velocidade Media Dia' =
			VAR _ult = [Ultima Coleta]
			VAR _dia = DATE ( YEAR ( _ult ), MONTH ( _ult ), DAY ( _ult ) )
			RETURN
			    CALCULATE (
			        DIVIDE (
			            SUMX ( resumo_coleta, resumo_coleta[vel_media_kmh] * resumo_coleta[no_ar] ),
			            SUM ( resumo_coleta[no_ar] )
			        ),
			        REMOVEFILTERS ( resumo_coleta ),
			        resumo_coleta[data_coleta] = _dia
			    )
		formatString: #,0
		displayFolder: Base
		lineageTag: 3593211f-76d4-4a48-be42-69ab82e7b4fa

	measure 'HTML Estilo Voos' =
			"<style>
			*{box-sizing:border-box;margin:0;padding:0}
			body{background:radial-gradient(1200px 700px at 55% 40%,#0f2147 0%,#0a1230 45%,#070c22 100%);font-family:'Segoe UI',sans-serif;color:#e2e8f0;overflow:hidden}
			.pg{color:#e2e8f0;height:100vh;padding:12px;display:grid;grid-template-rows:58px minmax(0,1fr) 104px;gap:12px}
			.rkn,.lg,td,.leg span,.hint b{color:#e2e8f0}
			.card{background:linear-gradient(180deg,rgba(30,41,82,.55),rgba(15,23,52,.55));border:1px solid rgba(96,165,250,.18);border-radius:14px;box-shadow:0 10px 30px rgba(0,0,0,.35);min-height:0;overflow:hidden}
			.hd{display:flex;align-items:center;padding:0 16px;gap:12px}
			.logo{width:38px;height:38px;border-radius:10px;background:linear-gradient(135deg,#38bdf8,#6366f1);display:grid;place-items:center}
			.ttl{font-size:19px;font-weight:700;color:#fff}.sub{font-size:11.5px;color:#94a3b8;margin-top:1px}
			.live{margin-left:auto;display:flex;align-items:center;gap:10px;font-size:12px;color:#94a3b8}.live b{color:#fff}
			.pill{border:1px solid #10b981;color:#34d399;border-radius:20px;padding:3px 10px;font-weight:600;display:flex;align-items:center;gap:6px}
			.pill i{width:7px;height:7px;border-radius:50%;background:#34d399;box-shadow:0 0 8px #34d399}
			.pill.off{border-color:#f59e0b;color:#fbbf24}.pill.off i{background:#fbbf24;box-shadow:0 0 8px #fbbf24}
			.main{display:grid;grid-template-columns:minmax(0,0.82fr) minmax(0,2.3fr) minmax(0,1fr);gap:12px;min-height:0}
			.col{display:grid;gap:12px;min-height:0}
			.pad{padding:14px 16px}
			.ct{font-size:14px;font-weight:600;color:#f1f5f9;display:flex;justify-content:space-between;align-items:baseline}
			.ct small{font-size:10.5px;color:#64748b;font-weight:500}
			.rk{display:grid;grid-template-columns:minmax(0,1fr) 48px 24px;align-items:center;gap:8px;font-size:11.5px;padding:6px 0;border-bottom:1px solid rgba(51,65,85,.45)}
			.rkn{display:flex;align-items:center;gap:7px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
			.rk b{text-align:right;color:#fff}
			.bar{height:6px;background:#1e293b;border-radius:4px;overflow:hidden}.bar i{display:block;height:100%;border-radius:4px}
			.sw{width:9px;height:9px;border-radius:3px;display:inline-block;flex:none}
			.dn{display:flex;align-items:center;gap:12px;margin-top:8px}
			.lg{display:flex;align-items:center;gap:7px;font-size:11.5px;padding:4px 0;min-width:100px}.lg b{margin-left:auto;color:#fff}
			.map{position:relative;padding:14px 16px;display:flex;flex-direction:column}
			.mapbox{flex:1;min-height:0;position:relative}.mapbox svg{position:absolute;inset:0;width:100%;height:100%}
			.leg{position:absolute;top:12px;right:14px;display:flex;gap:11px;font-size:10.5px;background:rgba(15,23,42,.7);border:1px solid rgba(96,165,250,.2);padding:5px 11px;border-radius:20px}
			.leg span{display:flex;align-items:center;gap:5px}
			.buscas{display:flex;gap:8px;margin-top:8px}
			.busca{width:190px;height:30px;border:1px dashed rgba(148,163,184,.35);border-radius:8px}
			.sel{position:absolute;right:16px;bottom:16px;width:225px;background:rgba(9,14,35,.92);border:1px solid rgba(251,146,60,.45);border-radius:12px;padding:11px 13px}
			.sel.vz{border-color:rgba(96,165,250,.25)}
			.sel .l{font-size:9.5px;letter-spacing:.08em;color:#94a3b8}.sel .v{font-size:12px;font-weight:600;color:#fff}
			.sel h3{font-size:16px;margin:2px 0;color:#fff}.sel .g{display:grid;grid-template-columns:1fr 1fr;gap:7px 10px;margin-top:8px}
			.tag{font-size:10px;color:#fb923c;border:1px solid #fb923c;border-radius:20px;padding:1px 8px}
			.hint{font-size:11.5px;color:#94a3b8;margin-top:4px;line-height:1.4}
			.dim{color:#94a3b8}
			table{width:100%;border-collapse:collapse;font-size:11.5px;margin-top:6px}
			th{font-size:9.5px;color:#64748b;text-align:left;font-weight:500;letter-spacing:.06em;padding:4px 0}
			td{padding:6px 0;border-bottom:1px solid rgba(51,65,85,.45);white-space:nowrap}.r{text-align:right}td.dim{color:#94a3b8}
			.mono{font-family:Consolas,monospace;color:#7dd3fc;font-size:11px}td.mono{color:#7dd3fc}
			.kpis{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px}
			.kpi{padding:14px 16px}.kt{font-size:10.5px;letter-spacing:.08em;color:#94a3b8}.kv{font-size:28px;font-weight:800;margin:3px 0 1px;color:#fff}
			.ks{font-size:11px;color:#94a3b8}.up{color:#34d399}.down{color:#f87171}
			</style>"
		displayFolder: HTML
		lineageTag: 0c4814d2-5522-41c7-9fee-7a6bb16e4d2a

	measure 'HTML Cabecalho Voos' =
			VAR _ult = [Ultima Coleta]
			VAR _aoVivo = NOT ISBLANK ( _ult ) && NOW () - _ult <= 90 / 1440
			VAR _pill =
			    IF (
			        _aoVivo,
			        "<span class='pill'><i></i>AO VIVO</span>",
			        "<span class='pill off'><i></i>DADOS ATRASADOS</span>"
			    )
			RETURN
			    "<div class='card hd'><div class='logo'><svg width='22' height='22' viewBox='-6 -6 12 12'><path transform='rotate(45)' d='M0 -5L1 -1.5L5 .7L5 1.7L1 .8L.7 3.5L2 4.6L2 5.2L0 4.6L-2 5.2L-2 4.6L-.7 3.5L-1 .8L-5 1.7L-5 .7L-1 -1.5Z' fill='#fff'/></svg></div>"
			        & "<div><div class='ttl'>Voos sobre o Brasil · Tempo Real</div><div class='sub'>Posição das aeronaves no espaço aéreo brasileiro · fonte: OpenSky Network</div></div>"
			        & "<div class='live'>" & _pill & "última coleta às <b>"
			        & FORMAT ( _ult, "HH:mm:ss" ) & "</b> · " & FORMAT ( _ult, "dd/MM" )
			        & "</div></div>"
		displayFolder: HTML
		lineageTag: 18c947f9-20d7-4b8d-af7e-d649dd984ecc

	measure 'HTML Companhias' =
			VAR _base =
			    CALCULATETABLE (
			        posicao_atual,
			        REMOVEFILTERS ( posicao_atual ),
			        posicao_atual[em_solo] = FALSE ()
			    )
			VAR _grp =
			    GROUPBY (
			        _base,
			        posicao_atual[companhia],
			        posicao_atual[tipo_companhia],
			        "n", COUNTX ( CURRENTGROUP (), 1 )
			    )
			VAR _top = TOPN ( 8, _grp, [n], DESC )
			VAR _max = MAXX ( _grp, [n] )
			VAR _linhas =
			    CONCATENATEX (
			        _top,
			        VAR _cor =
			            SWITCH (
			                TRUE (),
			                posicao_atual[companhia] = "LATAM Brasil", "#f43f5e",
			                posicao_atual[companhia] = "Gol", "#fb923c",
			                CONTAINSSTRING ( posicao_atual[companhia], "Azul" ), "#38bdf8",
			                posicao_atual[tipo_companhia] = "Aviação geral", "#94a3b8",
			                posicao_atual[companhia] IN { "Sem identificação", "Outras" }, "#64748b",
			                "#a78bfa"
			            )
			        RETURN
			            "<div class='rk'><div class='rkn'><span class='sw' style='background:" & _cor & "'></span>"
			                & posicao_atual[companhia]
			                & "</div><div class='bar'><i style='width:" & FORMAT ( DIVIDE ( [n], _max ) * 100, "0" )
			                & "%;background:" & _cor & "'></i></div><b>" & [n] & "</b></div>",
			        "",
			        [n], DESC
			    )
			RETURN
			    "<div class='card pad'><div class='ct'>Companhias no ar agora <small>aviões</small></div><div style='margin-top:6px'>"
			        & _linhas & "</div></div>"
		displayFolder: HTML
		lineageTag: 60c51d12-a11f-4d70-a459-455c129d285e

	measure 'HTML Fase Voo' =
			VAR _base = CALCULATETABLE ( posicao_atual, REMOVEFILTERS ( posicao_atual ) )
			VAR _cru = COUNTROWS ( FILTER ( _base, posicao_atual[fase_voo] = "Cruzeiro" ) ) + 0
			VAR _des = COUNTROWS ( FILTER ( _base, posicao_atual[fase_voo] = "Descendo" ) ) + 0
			VAR _sub = COUNTROWS ( FILTER ( _base, posicao_atual[fase_voo] = "Subindo" ) ) + 0
			VAR _sol = COUNTROWS ( FILTER ( _base, posicao_atual[fase_voo] = "Em solo" ) ) + 0
			VAR _tot = _cru + _des + _sub + _sol
			VAR _l1 = DIVIDE ( _cru, _tot ) * 1000
			VAR _l2 = DIVIDE ( _des, _tot ) * 1000
			VAR _l3 = DIVIDE ( _sub, _tot ) * 1000
			VAR _l4 = DIVIDE ( _sol, _tot ) * 1000
			VAR _arco = "<circle cx='60' cy='60' r='46' fill='none' stroke-width='13' pathLength='1000' transform='rotate(-90 60 60)' "
			VAR _svg =
			    "<svg viewBox='0 0 120 120' style='width:140px;height:140px;flex:none'>"
			        & _arco & "stroke='#38bdf8' stroke-dasharray='" & FORMAT ( MAX ( _l1 - 6, 0 ), "0" ) & " 1000' stroke-dashoffset='0'/>"
			        & _arco & "stroke='#f59e0b' stroke-dasharray='" & FORMAT ( MAX ( _l2 - 6, 0 ), "0" ) & " 1000' stroke-dashoffset='-" & FORMAT ( _l1, "0" ) & "'/>"
			        & _arco & "stroke='#34d399' stroke-dasharray='" & FORMAT ( MAX ( _l3 - 6, 0 ), "0" ) & " 1000' stroke-dashoffset='-" & FORMAT ( _l1 + _l2, "0" ) & "'/>"
			        & _arco & "stroke='#64748b' stroke-dasharray='" & FORMAT ( MAX ( _l4 - 6, 0 ), "0" ) & " 1000' stroke-dashoffset='-" & FORMAT ( _l1 + _l2 + _l3, "0" ) & "'/>"
			        & "<text x='60' y='61' font-size='22' font-weight='800' fill='#fff' text-anchor='middle'>" & FORMAT ( _cru + _des + _sub, "0" ) & "</text>"
			        & "<text x='60' y='76' font-size='8' fill='#94a3b8' text-anchor='middle'>no ar agora</text></svg>"
			VAR _leg =
			    "<div class='lg'><span class='sw' style='background:#38bdf8'></span>Cruzeiro<b>" & _cru & "</b></div>"
			        & "<div class='lg'><span class='sw' style='background:#f59e0b'></span>Descendo<b>" & _des & "</b></div>"
			        & "<div class='lg'><span class='sw' style='background:#34d399'></span>Subindo<b>" & _sub & "</b></div>"
			        & "<div class='lg'><span class='sw' style='background:#64748b'></span>Em solo<b>" & _sol & "</b></div>"
			RETURN
			    "<div class='card pad'><div class='ct'>Fase do voo <small>última coleta</small></div><div class='dn'>"
			        & _svg & "<div>" & _leg & "</div></div></div>"
		displayFolder: HTML
		lineageTag: 76a371da-b6cc-4325-af63-e8933c89b3cf

	measure 'HTML Voo Selecionado' =
			IF (
			    ISFILTERED ( posicao_atual[voo] ) && HASONEVALUE ( posicao_atual[icao24] ),
			    VAR _voo = COALESCE ( SELECTEDVALUE ( posicao_atual[voo] ), "sem identificação" )
			    VAR _cia = SELECTEDVALUE ( posicao_atual[companhia] )
			    VAR _fase = SELECTEDVALUE ( posicao_atual[fase_voo] )
			    VAR _alt = MAX ( posicao_atual[altitude_m] )
			    VAR _vel = MAX ( posicao_atual[velocidade_kmh] )
			    VAR _dir = MAX ( posicao_atual[direcao_graus] )
			    VAR _pais = SELECTEDVALUE ( posicao_atual[pais_origem] )
			    VAR _hora = MAX ( posicao_atual[coleta_brt] )
			    VAR _card =
			        SWITCH (
			            INT ( MOD ( _dir + 22.5, 360 ) / 45 ),
			            0, "N", 1, "NE", 2, "L", 3, "SE", 4, "S", 5, "SO", 6, "O", 7, "NO"
			        )
			    RETURN
			        "<div class='sel'><div style='display:flex;justify-content:space-between;align-items:center'><span class='l'>VOO SELECIONADO</span><span class='tag'>"
			            & LOWER ( _fase ) & "</span></div>"
			            & "<h3>" & _voo & " · " & _cia & "</h3><div class='dim' style='font-size:11px'>registro: " & _pais & " · rastro das últimas 3 h</div>"
			            & "<div class='g'><div><div class='l'>ALTITUDE</div><div class='v'>" & FORMAT ( _alt, "#,##0" ) & " m</div></div>"
			            & "<div><div class='l'>VELOCIDADE</div><div class='v'>" & FORMAT ( _vel, "#,##0" ) & " km/h</div></div>"
			            & "<div><div class='l'>DIREÇÃO</div><div class='v'>" & FORMAT ( _dir, "0" ) & "° · " & _card & "</div></div>"
			            & "<div><div class='l'>POSIÇÃO ÀS</div><div class='v'>" & FORMAT ( _hora, "HH:mm:ss" ) & "</div></div></div></div>",
			    "<div class='sel vz'><span class='l'>NAVEGAR NO MAPA</span><div class='hint'>Use <b>Região</b> para aproximar o mapa e <b>Buscar voo</b> para centralizar um avião e ver o rastro das últimas 3 horas.</div></div>"
			)
		displayFolder: HTML
		lineageTag: 9f34cc32-5779-49a9-9a5b-d43946c1ad5b

	measure 'HTML Serie Voos' =
			VAR _ult = CALCULATE ( MAX ( resumo_coleta[coleta_brt] ), REMOVEFILTERS ( resumo_coleta ) )
			VAR _ini = _ult - 1
			VAR _W = 600
			VAR _H = 300
			VAR _t =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            VALUES ( resumo_coleta[coleta_brt] ),
			            REMOVEFILTERS ( resumo_coleta ),
			            resumo_coleta[coleta_brt] > _ini
			        ),
			        "n", CALCULATE ( SUM ( resumo_coleta[no_ar] ), REMOVEFILTERS ( resumo_coleta[companhia], resumo_coleta[tipo_companhia] ) )
			    )
			VAR _maxN = MAXX ( _t, [n] )
			VAR _ymax = MAX ( CEILING ( _maxN, 50 ), 50 )
			VAR _pts =
			    ADDCOLUMNS (
			        _t,
			        "x", 40 + ( resumo_coleta[coleta_brt] - _ini ) * ( _W - 55 ),
			        "y", _H - 28 - DIVIDE ( [n], _ymax ) * ( _H - 50 )
			    )
			VAR _linha =
			    CONCATENATEX ( _pts, FORMAT ( [x], "0" ) & "," & FORMAT ( [y], "0" ), " ", resumo_coleta[coleta_brt], ASC )
			VAR _x0 = MINX ( _pts, [x] )
			VAR _x1 = MAXX ( _pts, [x] )
			VAR _area =
			    "M" & FORMAT ( _x0, "0" ) & "," & FORMAT ( _H - 28, "0" ) & " L" & SUBSTITUTE ( _linha, " ", " L" )
			        & " L" & FORMAT ( _x1, "0" ) & "," & FORMAT ( _H - 28, "0" ) & "Z"
			VAR _grade =
			    CONCATENATEX (
			        GENERATESERIES ( 0, 4, 1 ),
			        VAR _v = _ymax * [Value] / 4
			        VAR _yy = _H - 28 - DIVIDE ( _v, _ymax ) * ( _H - 50 )
			        RETURN
			            "<line x1='40' x2='" & _W - 10 & "' y1='" & FORMAT ( _yy, "0" ) & "' y2='" & FORMAT ( _yy, "0" )
			                & "' stroke='#1e293b'/><text x='32' y='" & FORMAT ( _yy + 4, "0" )
			                & "' font-size='11' fill='#64748b' text-anchor='end'>" & FORMAT ( _v, "0" ) & "</text>",
			        ""
			    )
			VAR _eixoX =
			    CONCATENATEX (
			        GENERATESERIES ( 0, 6, 1 ),
			        VAR _tt = _ini + [Value] * 4 / 24
			        VAR _xx = 40 + [Value] * 4 / 24 * ( _W - 55 )
			        RETURN
			            "<text x='" & FORMAT ( _xx, "0" ) & "' y='" & _H - 8
			                & "' font-size='11' fill='#64748b' text-anchor='middle'>" & FORMAT ( _tt, "HH" ) & "h</text>",
			        ""
			    )
			VAR _pico = TOPN ( 1, _pts, [n], DESC, resumo_coleta[coleta_brt], DESC )
			VAR _px = MAXX ( _pico, [x] )
			VAR _py = MAXX ( _pico, [y] )
			VAR _marca =
			    "<circle cx='" & FORMAT ( _px, "0" ) & "' cy='" & FORMAT ( _py, "0" )
			        & "' r='4.5' fill='#0b1023' stroke='#38bdf8' stroke-width='2.5'/>"
			        & "<rect x='" & FORMAT ( _px - 36, "0" ) & "' y='" & FORMAT ( _py - 30, "0" )
			        & "' width='72' height='20' rx='5' fill='#1d4ed8'/><text x='" & FORMAT ( _px, "0" ) & "' y='" & FORMAT ( _py - 16, "0" )
			        & "' font-size='11.5' fill='#fff' text-anchor='middle' font-weight='700'>pico " & FORMAT ( _maxN, "0" ) & "</text>"
			VAR _svg =
			    "<svg viewBox='0 0 " & _W & " " & _H & "' preserveAspectRatio='xMidYMid meet' style='width:100%;height:100%'>"
			        & "<defs><linearGradient id='ga' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#38bdf8' stop-opacity='.45'/><stop offset='1' stop-color='#38bdf8' stop-opacity='0'/></linearGradient></defs>"
			        & _grade & "<path d='" & _area & "' fill='url(#ga)'/>"
			        & "<polyline points='" & _linha & "' fill='none' stroke='#38bdf8' stroke-width='2.5' stroke-linejoin='round'/>"
			        & _marca & _eixoX & "</svg>"
			RETURN
			    "<div class='card pad' style='display:flex;flex-direction:column'><div class='ct'>Aviões no ar · últimas 24 h <small>a cada coleta</small></div>"
			        & "<div style='flex:1;min-height:0;margin-top:8px'>" & _svg & "</div></div>"
		displayFolder: HTML
		lineageTag: e236821c-8495-43b0-a72e-eb7e13df4a6b

	measure 'HTML Mais Rapidos' =
			VAR _base =
			    CALCULATETABLE (
			        posicao_atual,
			        REMOVEFILTERS ( posicao_atual ),
			        posicao_atual[em_solo] = FALSE (),
			        NOT ISBLANK ( posicao_atual[velocidade_kmh] )
			    )
			VAR _top = TOPN ( 7, _base, posicao_atual[velocidade_kmh], DESC, posicao_atual[icao24], ASC )
			VAR _linhas =
			    CONCATENATEX (
			        _top,
			        "<tr><td class='mono'>" & COALESCE ( posicao_atual[voo], "—" ) & "</td><td>"
			            & LEFT ( posicao_atual[companhia], 20 ) & "</td><td class='r'>"
			            & FORMAT ( posicao_atual[velocidade_kmh], "#,##0" ) & "</td><td class='r dim'>"
			            & FORMAT ( posicao_atual[altitude_m], "#,##0" ) & "</td></tr>",
			        "",
			        posicao_atual[velocidade_kmh], DESC
			    )
			RETURN
			    "<div class='card pad'><div class='ct'>Mais rápidos agora <small>km/h</small></div>"
			        & "<table><tr><th>VOO</th><th>COMPANHIA</th><th class='r'>KM/H</th><th class='r'>ALT. (M)</th></tr>"
			        & _linhas & "</table></div>"
		displayFolder: HTML
		lineageTag: d81f7a12-6f4b-416c-a3da-0fd21184e728

	measure 'HTML KPIs Voos' =
			VAR _ult = [Ultima Coleta]
			VAR _dia = DATE ( YEAR ( _ult ), MONTH ( _ult ), DAY ( _ult ) )
			VAR _noAr = [Avioes No Ar]
			VAR _ontem = [Avioes No Ar Ontem]
			VAR _var = DIVIDE ( _noAr - _ontem, _ontem )
			VAR _txtOntem =
			    IF (
			        ISBLANK ( _ontem ),
			        "sem coleta de ontem ainda",
			        IF ( _var >= 0, "<span class='up'>▲ ", "<span class='down'>▼ " )
			            & FORMAT ( ABS ( _var ), "0.0%" ) & "</span> vs mesmo horário ontem"
			    )
			VAR _vel = [Velocidade Media No Ar]
			VAR _velDia = [Velocidade Media Dia]
			VAR _dVel = _vel - _velDia
			VAR _txtVel =
			    IF (
			        ISBLANK ( _velDia ),
			        "média das aeronaves em voo",
			        IF ( _dVel >= 0, "<span class='up'>▲ ", "<span class='down'>▼ " )
			            & FORMAT ( ABS ( _dVel ), "0" ) & " km/h</span> vs média do dia"
			    )
			VAR _alt = [Altitude Media No Ar]
			VAR _picoTab =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            VALUES ( resumo_coleta[coleta_brt] ),
			            REMOVEFILTERS ( resumo_coleta ),
			            resumo_coleta[data_coleta] = _dia
			        ),
			        "n", CALCULATE ( SUM ( resumo_coleta[no_ar] ), REMOVEFILTERS ( resumo_coleta[companhia], resumo_coleta[tipo_companhia] ) )
			    )
			VAR _pico = MAXX ( _picoTab, [n] )
			VAR _picoHora = MAXX ( TOPN ( 1, _picoTab, [n], DESC, resumo_coleta[coleta_brt], DESC ), resumo_coleta[coleta_brt] )
			VAR _k = "<div class='card kpi'><div class='kt'>"
			RETURN
			    "<div class='kpis'>"
			        & _k & "AVIÕES NO AR</div><div class='kv'>" & FORMAT ( _noAr, "#,##0" ) & "</div><div class='ks'>" & _txtOntem & "</div></div>"
			        & _k & "EM SOLO / TAXIANDO</div><div class='kv'>" & FORMAT ( [Avioes Em Solo] + 0, "#,##0" ) & "</div><div class='ks'>com sinal na última coleta</div></div>"
			        & _k & "VELOCIDADE MÉDIA</div><div class='kv'>" & FORMAT ( _vel, "#,##0" ) & " km/h</div><div class='ks'>" & _txtVel & "</div></div>"
			        & _k & "ALTITUDE MÉDIA</div><div class='kv'>" & FORMAT ( _alt, "#,##0" ) & " m</div><div class='ks'>≈ " & FORMAT ( _alt * 3.281, "#,##0" ) & " pés</div></div>"
			        & _k & "PICO DO DIA</div><div class='kv'>" & FORMAT ( _pico, "#,##0" ) & "</div><div class='ks'>às "
			        & FORMAT ( _picoHora, "HH:mm" ) & " · " & [Companhias No Ar] & " companhias no ar agora</div></div>"
			        & "</div>"
		displayFolder: HTML
		lineageTag: 2da5fc0f-2168-4950-a49f-162c62355a33

	/// Contorno dos estados (x = (lon+74.2)*10.1, y = (5.4-lat)*10.4) e aeroportos principais
	measure 'SVG Brasil Contorno' = "<path d='M212 292L220 286L231 268L240 262L252 264L252 267L254 266L255 268L256 266L270 264L272 266L272 274L275 279L280 279L278 288L281 290L281 294L286 294L288 291L291 292L297 289L299 291L303 291L302 293L297 295L298 299L291 302L291 304L286 303L275 309L266 315L264 319L262 316L259 317L260 314L252 313L252 309L248 304L248 298L245 294L237 295L224 290L212 292ZM327 85L327 88L323 92L320 92L315 100L317 110L314 115L314 119L317 121L316 126L310 127L305 127L298 133L290 136L285 149L287 155L285 163L281 162L278 158L279 155L274 150L277 144L280 144L280 139L275 140L270 132L267 131L270 129L271 124L270 114L261 110L257 112L269 103L274 96L285 67L285 69L288 68L288 70L289 69L290 72L292 70L292 74L296 71L297 74L300 75L298 80L300 79L301 80L297 90L301 87L301 83L304 81L302 85L303 86L308 80L311 83L311 80L312 81L323 86L326 86L323 84L327 85ZM232 62L231 67L225 71L229 62L232 62ZM235 59L234 59L237 56L238 57L235 59ZM250 55L250 57L247 58L250 55ZM242 53L249 52L248 54L244 57L241 56L242 53ZM241 51L240 52L241 51ZM244 50L242 52L241 51L244 50ZM249 74L238 75L236 71L236 67L239 68L236 67L237 63L238 59L241 57L252 58L261 60L256 71L255 70L256 71L254 72L253 71L253 73L251 72L249 74ZM284 69L282 79L274 96L269 103L257 112L263 115L262 118L258 125L253 128L251 135L253 137L251 143L244 153L242 159L176 154L168 147L167 142L159 126L180 80L162 69L156 63L154 43L158 43L160 40L163 40L173 35L184 37L185 35L183 32L184 30L187 31L194 30L197 33L197 38L200 38L210 43L219 65L225 68L224 71L217 73L221 72L222 74L236 66L235 68L238 74L236 76L238 75L240 78L245 75L246 77L252 75L248 84L255 73L255 75L258 71L260 73L260 72L261 71L260 71L260 69L262 69L260 68L265 63L274 63L274 65L277 64L280 67L283 66L284 69ZM259 326L257 329L257 327L260 339L258 350L257 352L256 351L256 354L247 361L243 361L247 352L238 351L233 345L222 340L210 338L206 339L207 329L230 334L232 333L232 330L238 327L245 327L249 329L259 326ZM343 243L343 241L339 237L340 232L342 232L347 224L343 221L332 220L327 213L324 214L316 209L308 209L306 209L307 205L302 204L284 21