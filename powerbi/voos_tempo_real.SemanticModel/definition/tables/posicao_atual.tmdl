 376L175 369L172 371L168 370L184 353L187 352L186 350L204 339L214 338L230 343L238 351L247 352L243 361L247 361ZM285 163L287 164L282 168L279 174L284 177L282 179L284 180L281 182L283 186L282 189L269 194L268 193L268 195L263 192L257 195L254 188L251 194L248 193L242 191L243 185L238 189L237 176L238 167L244 153L249 148L253 140L253 137L251 135L253 128L261 122L263 115L261 112L257 112L261 110L266 111L270 114L271 121L270 129L267 131L270 132L275 140L279 138L280 140L280 144L277 144L274 150L279 155L278 158L281 162L285 163ZM287 164L285 163L287 155L285 149L290 136L298 133L305 127L310 127L316 126L317 121L314 119L314 115L317 110L315 100L320 92L325 90L327 85L332 87L331 92L334 100L333 107L338 124L341 127L340 133L338 133L339 141L328 150L327 152L322 153L319 156L311 153L307 154L308 161L303 167L294 169L287 164ZM394 149L382 165L376 160L365 155L363 153L368 148L376 153L382 152L386 149L394 149ZM396 124L398 135L391 134L390 136L382 138L376 142L374 139L372 139L376 134L373 132L363 138L359 135L360 132L358 128L360 123L364 124L373 119L371 126L378 127L379 129L382 122L396 124ZM360 123L358 128L360 132L356 138L349 133L340 133L341 127L338 124L333 107L333 103L335 101L331 91L333 86L346 86L361 95L370 104L372 105L373 106L368 109L360 123ZM382 165L369 176L366 174L363 169L364 168L366 168L368 167L368 161L366 155L376 160L382 165ZM109 33L109 31L103 30L101 19L96 12L102 14L103 16L110 15L114 19L116 18L115 14L133 9L137 5L137 2L141 1L144 3L142 9L147 11L148 15L145 19L145 21L143 28L146 33L146 37L154 43L155 54L143 54L138 65L136 65L132 61L129 63L127 71L124 70L118 64L120 63L117 56L119 48L115 39L116 36L109 33ZM394 149L386 149L382 152L376 153L368 148L363 153L360 148L359 149L351 145L339 155L336 148L332 147L339 141L340 138L338 133L340 133L349 133L355 138L359 135L363 138L373 132L376 134L372 139L374 139L376 142L382 138L387 137L391 134L395 133L398 135L398 138L394 149ZM207 329L205 323L203 321L199 323L198 321L202 319L200 318L200 315L203 313L201 307L209 294L215 291L224 290L237 295L245 294L248 298L248 304L250 307L252 309L252 313L258 313L260 314L259 317L262 316L264 319L261 322L261 319L260 321L257 320L261 322L259 326L249 329L245 327L238 327L232 330L232 333L230 334L207 329ZM327 272L327 268L332 266L336 259L336 255L333 252L336 252L334 246L338 244L336 243L341 242L349 247L348 258L336 277L328 276L327 272ZM298 299L297 295L303 292L297 289L322 282L324 274L327 272L328 276L336 277L335 280L335 285L326 291L326 293L325 295L315 295L314 292L312 293L313 295L305 296L309 295L305 295L302 298L303 295L301 295L298 296L300 298L298 299ZM360 123L368 109L373 106L380 109L386 109L392 110L396 124L389 123L382 122L379 129L378 127L371 126L373 119L364 124L360 123ZM109 33L116 36L115 39L119 48L117 56L120 63L118 64L124 70L127 71L129 63L132 61L136 65L140 63L140 59L143 54L155 54L155 60L160 67L176 79L179 79L180 81L159 126L162 132L158 147L126 147L124 148L116 140L108 139L103 144L102 149L95 150L92 154L91 152L85 156L79 154L74 158L39 141L16 135L4 130L5 127L11 123L10 119L13 110L21 104L33 102L36 99L43 101L48 68L46 61L42 57L42 50L51 49L50 45L44 45L44 38L61 38L61 35L63 38L68 34L72 38L72 44L74 43L81 49L87 46L87 49L92 44L102 40L103 36L109 33ZM162 132L167 142L168 147L176 154L242 159L237 176L239 191L236 199L233 211L228 214L225 221L217 226L218 228L212 236L214 244L204 242L207 236L203 239L199 238L192 240L183 235L176 236L172 241L168 241L160 236L159 230L160 226L142 225L141 217L138 213L141 213L140 208L139 205L140 202L136 198L140 196L145 185L142 177L144 175L143 172L139 171L128 170L127 147L158 147L162 132ZM272 223L263 223L263 217L270 217L272 223ZM76 159L65 167L62 167L60 170L55 172L55 171L49 170L36 171L37 154L30 160L20 160L19 155L10 154L12 150L2 135L5 132L4 130L16 135L39 141L76 159ZM136 198L133 196L125 197L121 193L115 191L112 188L99 186L93 181L89 172L89 157L74 158L79 154L85 156L91 152L92 154L95 150L102 149L103 144L108 139L116 140L122 147L127 147L128 170L139 171L143 172L144 175L142 177L145 185L140 196L136 198Z' fill='#0f1d3d' stroke='#3b82f6' stroke-opacity='.5' stroke-width='.6' stroke-linejoin='round'/><circle cx='280' cy='300' r='2.4' fill='none' stroke='#e2e8f0' stroke-opacity='.5' stroke-width='.7'/><text x='284' y='302' class='ap'>GRU</text><circle cx='313' cy='293' r='2.4' fill='none' stroke='#e2e8f0' stroke-opacity='.5' stroke-width='.7'/><text x='317' y='295' class='ap'>GIG</text><circle cx='265' cy='221' r='2.4' fill='none' stroke='#e2e8f0' stroke-opacity='.5' stroke-width='.7'/><text x='269' y='223' class='ap'>BSB</text><circle cx='305' cy='260' r='2.4' fill='none' stroke='#e2e8f0' stroke-opacity='.5' stroke-width='.7'/><text x='309' y='262' class='ap'>CNF</text><circle cx='233' cy='368' r='2.4' fill='none' stroke='#e2e8f0' stroke-opacity='.5' stroke-width='.7'/><text x='237' y='370' class='ap'>POA</text><circle cx='362' cy='190' r='2.4' fill='none' stroke='#e2e8f0' stroke-opacity='.5' stroke-width='.7'/><text x='366' y='192' class='ap'>SSA</text><circle cx='397' cy='141' r='2.4' fill='none' stroke='#e2e8f0' stroke-opacity='.5' stroke-width='.7'/><text x='401' y='143' class='ap'>REC</text><circle cx='360' cy='95' r='2.4' fill='none' stroke='#e2e8f0' stroke-opacity='.5' stroke-width='.7'/><text x='364' y='97' class='ap'>FOR</text><circle cx='143' cy='88' r='2.4' fill='none' stroke='#e2e8f0' stroke-opacity='.5' stroke-width='.7'/><text x='147' y='90' class='ap'>MAO</text><circle cx='260' cy='71' r='2.4' fill='none' stroke='#e2e8f0' stroke-opacity='.5' stroke-width='.7'/><text x='264' y='73' class='ap'>BEL</text><circle cx='253' cy='322' r='2.4' fill='none' stroke='#e2e8f0' stroke-opacity='.5' stroke-width='.7'/><text x='257' y='324' class='ap'>CWB</text>"
		displayFolder: HTML
		lineageTag: 44ef537c-c5ab-42fa-ac5a-0f689a415ab2

	measure 'HTML Mapa Voos' =
			VAR _ultUtc = CALCULATE ( MAX ( fato_posicoes[coleta_utc] ), REMOVEFILTERS ( fato_posicoes ) )
			VAR _sel =
			    IF (
			        ISFILTERED ( posicao_atual[voo] ),
			        SELECTEDVALUE ( posicao_atual[icao24] )
			    )
			VAR _temSel = NOT ISBLANK ( _sel )
			VAR _selX =
			    CALCULATE ( ( MAX ( posicao_atual[longitude] ) + 74.2 ) * 10.1, REMOVEFILTERS ( posicao_atual ), posicao_atual[icao24] = _sel )
			VAR _selY =
			    CALCULATE ( ( 5.4 - MAX ( posicao_atual[latitude] ) ) * 10.4, REMOVEFILTERS ( posicao_atual ), posicao_atual[icao24] = _sel )
			
			// --- zoom: voo selecionado > regiao escolhida > Brasil inteiro
			VAR _reg = SELECTEDVALUE ( 'Zoom Mapa'[Regiao] )
			VAR _vw = IF ( _temSel, 80, COALESCE ( SELECTEDVALUE ( 'Zoom Mapa'[VW] ), 420 ) )
			VAR _vx = IF ( _temSel, _selX - 40, COALESCE ( SELECTEDVALUE ( 'Zoom Mapa'[VX] ), -10 ) )
			VAR _vy = IF ( _temSel, _selY - 40, COALESCE ( SELECTEDVALUE ( 'Zoom Mapa'[VY] ), -5 ) )
			VAR _z = _vw / 420
			VAR _esc = SUBSTITUTE ( FORMAT ( 0.9 * _z, "0.000" ), ",", "." )
			VAR _aproximado = _vw <= 100
			VAR _aviao = "<path d='M0 -5L1 -1.5L5 .7L5 1.7L1 .8L.7 3.5L2 4.6L2 5.2L0 4.6L-2 5.2L-2 4.6L-.7 3.5L-1 .8L-5 1.7L-5 .7L-1 -1.5Z' fill='"
			
			// --- avioes (no ar; em solo aparecem quando o mapa esta aproximado)
			VAR _avioes =
			    FILTER (
			        CALCULATETABLE ( posicao_atual, REMOVEFILTERS ( posicao_atual ) ),
			        posicao_atual[em_solo] = FALSE () || _aproximado
			    )
			VAR _svgAvioes =
			    CONCATENATEX (
			        _avioes,
			        VAR _x = ( posicao_atual[longitude] + 74.2 ) * 10.1
			        VAR _y = ( 5.4 - posicao_atual[latitude] ) * 10.4
			        VAR _cor =
			            SWITCH (
			                TRUE (),
			                posicao_atual[em_solo] = TRUE (), "#64748b",
			                posicao_atual[companhia] = "LATAM Brasil", "#f43f5e",
			                posicao_atual[companhia] = "Gol", "#fb923c",
			                CONTAINSSTRING ( posicao_atual[companhia], "Azul" ), "#38bdf8",
			                posicao_atual[tipo_companhia] = "Aviação geral", "#94a3b8",
			                posicao_atual[companhia] IN { "Sem identificação", "Outras" }, "#64748b",
			                "#a78bfa"
			            )
			        VAR _op = IF ( _temSel && posicao_atual[icao24] <> _sel, "0.3", "1" )
			        RETURN
			            "<g transform='translate(" & SUBSTITUTE ( FORMAT ( _x, "0.0" ), ",", "." ) & " " & SUBSTITUTE ( FORMAT ( _y, "0.0" ), ",", "." )
			                & ") rotate(" & FORMAT ( COALESCE ( posicao_atual[direcao_graus], 0 ), "0" ) & ") scale(" & _esc & ")' opacity='" & _op & "'>"
			                & "<title>" & COALESCE ( posicao_atual[voo], "sem identificação" ) & " · " & posicao_atual[companhia]
			                & " · " & IF ( posicao_atual[em_solo], "em solo", FORMAT ( posicao_atual[altitude_m], "#,##0" ) & " m · "
			                & FORMAT ( posicao_atual[velocidade_kmh], "#,##0" ) & " km/h" ) & "</title>"
			                & _aviao & _cor & "'/></g>",
			        ""
			    )
			
			// --- rastros curtos de todos os avioes (ultimos 12 min)
			VAR _rastro =
			    CALCULATETABLE (
			        fato_posicoes,
			        REMOVEFILTERS ( fato_posicoes ),
			        fato_posicoes[coleta_utc] >= _ultUtc - 12 / 1440,
			        fato_posicoes[em_solo] = FALSE ()
			    )
			VAR _ids =
			    SUMMARIZE ( _rastro, fato_posicoes[icao24], fato_posicoes[companhia], fato_posicoes[tipo_companhia] )
			VAR _svgRastros =
			    CONCATENATEX (
			        _ids,
			        VAR _id = fato_posicoes[icao24]
			        VAR _cor =
			            SWITCH (
			                TRUE (),
			                fato_posicoes[companhia] = "LATAM Brasil", "#f43f5e",
			                fato_posicoes[companhia] = "Gol", "#fb923c",
			                CONTAINSSTRING ( fato_posicoes[companhia], "Azul" ), "#38bdf8",
			                fato_posicoes[tipo_companhia] = "Aviação geral", "#94a3b8",
			                fato_posicoes[companhia] IN { "Sem identificação", "Outras" }, "#64748b",
			                "#a78bfa"
			            )
			        VAR _pts =
			            CONCATENATEX (
			                FILTER ( _rastro, fato_posicoes[icao24] = _id ),
			                SUBSTITUTE ( FORMAT ( ( fato_posicoes[longitude] + 74.2 ) * 10.1, "0.0" ), ",", "." ) & ","
			                    & SUBSTITUTE ( FORMAT ( ( 5.4 - fato_posicoes[latitude] ) * 10.4, "0.0" ), ",", "." ),
			                " ",
			                fato_posicoes[coleta_utc], ASC
			            )
			        RETURN
			            "<polyline points='" & _pts & "' fill='none' stroke='" & _cor
			                & "' stroke-width='1.2' vector-effect='non-scaling-stroke' stroke-opacity='" & IF ( _temSel, ".12", ".45" ) & "'/>",
			        ""
			    )
			
			// --- voo selecionado: rastro longo + destaque
			VAR _selTab =
			    CALCULATETABLE (
			        fato_posicoes,
			        REMOVEFILTERS ( fato_posicoes ),
			        fato_posicoes[icao24] = _sel,
			        fato_posicoes[coleta_utc] >= _ultUtc - 3 / 24
			    )
			VAR _selPts =
			    CONCATENATEX (
			        _selTab,
			        SUBSTITUTE ( FORMAT ( ( fato_posicoes[longitude] + 74.2 ) * 10.1, "0.0" ), ",", "." ) & ","
			            & SUBSTITUTE ( FORMAT ( ( 5.4 - fato_posicoes[latitude] ) * 10.4, "0.0" ), ",", "." ),
			        " ",
			        fato_posicoes[coleta_utc], ASC
			    )
			VAR _svgSel =
			    IF (
			        _temSel,
			        "<polyline points='" & _selPts & "' fill='none' stroke='#fb923c' stroke-width='2.2' stroke-dasharray='6 4' vector-effect='non-scaling-stroke'/>"
			            & "<circle cx='" & SUBSTITUTE ( FORMAT ( _selX, "0.0" ), ",", "." ) & "' cy='" & SUBSTITUTE ( FORMAT ( _selY, "0.0" ), ",", "." )
			            & "' r='" & SUBSTITUTE ( FORMAT ( 8 * _z, "0.00" ), ",", "." )
			            & "' fill='#fb923c' fill-opacity='.18' stroke='#fb923c' stroke-width='1' vector-effect='non-scaling-stroke'/>"
			    )
			
			// --- contorno (sem os aeroportos fixos) + aeroportos com tamanho ajustado ao zoom
			VAR _base = [SVG Brasil Contorno]
			VAR _contorno =
			    SUBSTITUTE (
			        LEFT ( _base, SEARCH ( "<circle", _base ) - 1 ),
			        "stroke-width='.6'",
			        "stroke-width='1' vector-effect='non-scaling-stroke'"
			    )
			VAR _aerop =
			    DATATABLE (
			        "Cod", STRING, "Lat", DOUBLE, "Lon", DOUBLE, "Principal", INTEGER,
			        {
			            { "GRU", -23.43, -46.47, 1 }, { "CGH", -23.63, -46.66, 0 }, { "VCP", -23.01, -47.13, 0 },
			            { "GIG", -22.81, -43.25, 1 }, { "SDU", -22.91, -43.16, 0 }, { "BSB", -15.87, -47.92, 1 },
			            { "CNF", -19.63, -43.97, 1 }, { "CWB", -25.53, -49.17, 1 }, { "POA", -29.99, -51.17, 1 },
			            { "FLN", -27.67, -48.55, 0 }, { "SSA", -12.91, -38.33, 1 }, { "REC", -8.13, -34.92, 1 },
			            { "FOR", -3.78, -38.53, 1 }, { "BEL", -1.38, -48.48, 1 }, { "MAO", -3.04, -60.05, 1 },
			            { "GYN", -16.63, -49.22, 0 }, { "CGB", -15.65, -56.12, 0 }, { "VIX", -20.26, -40.29, 0 },
			            { "NAT", -5.77, -35.37, 0 }
			        }
			    )
			VAR _svgAerop =
			    CONCATENATEX (
			        FILTER ( _aerop, [Principal] = 1 || _vw <= 200 ),
			        VAR _x = ( [Lon] + 74.2 ) * 10.1
			        VAR _y = ( 5.4 - [Lat] ) * 10.4
			        RETURN
			            "<circle cx='" & SUBSTITUTE ( FORMAT ( _x, "0.0" ), ",", "." ) & "' cy='" & SUBSTITUTE ( FORMAT ( _y, "0.0" ), ",", "." )
			                & "' r='" & SUBSTITUTE ( FORMAT ( 2.4 * _z, "0.00" ), ",", "." )
			                & "' fill='none' stroke='#e2e8f0' stroke-opacity='.5' stroke-width='1' vector-effect='non-scaling-stroke'/>"
			                & "<text x='" & SUBSTITUTE ( FORMAT ( _x + 4 * _z, "0.0" ), ",", "." ) & "' y='" & SUBSTITUTE ( FORMAT ( _y + 2 * _z, "0.0" ), ",", "." )
			                & "' font-size='" & SUBSTITUTE ( FORMAT ( 5.5 * _z, "0.00" ), ",", "." )
			                & "' fill='#cbd5e1' fill-opacity='.75' font-weight='600'>" & [Cod] & "</text>",
			        ""
			    )
			
			VAR _viewBox =
			    SUBSTITUTE ( FORMAT ( _vx, "0.0" ), ",", "." ) & " " & SUBSTITUTE ( FORMAT ( _vy, "0.0" ), ",", "." ) & " "
			        & SUBSTITUTE ( FORMAT ( _vw, "0.0" ), ",", "." ) & " " & SUBSTITUTE ( FORMAT ( _vw, "0.0" ), ",", "." )
			VAR _titulo =
			    IF (
			        _temSel,
			        "centralizado no voo selecionado",
			        COALESCE ( _reg, "Brasil" )
			    )
			VAR _svg =
			    "<svg viewBox='" & _viewBox & "' preserveAspectRatio='xMidYMid meet'>"
			        & "<defs><radialGradient id='gl' cx='60%' cy='65%' r='60%'><stop offset='0' stop-color='#1d4ed8' stop-opacity='.28'/><stop offset='1' stop-color='#1d4ed8' stop-opacity='0'/></radialGradient></defs>"
			        & "<ellipse cx='260' cy='270' rx='190' ry='160' fill='url(#gl)'/>"
			        & _contorno & _svgAerop & _svgRastros & _svgSel & _svgAvioes & "</svg>"
			RETURN
			    "<div class='card map'><div class='ct'>Mapa ao vivo · " & _titulo & "</div>"
			        & "<div class='sub'>cada avião aponta para a direção do voo · linhas = trajeto dos últimos 12 min · passe o mouse para detalhes"
			        & IF ( _aproximado, " · aviões em cinza = em solo", "" ) & "</div>"
			        & "<div class='buscas'><div class='busca'></div><div class='busca'></div></div>"
			        & "<div class='leg'><span><i class='sw' style='background:#f43f5e'></i>LATAM</span><span><i class='sw' style='background:#fb923c'></i>Gol</span><span><i class='sw' style='background:#38bdf8'></i>Azul</span><span><i class='sw' style='background:#a78bfa'></i>Estrangeiras</span><span><i class='sw' style='background:#94a3b8'></i>Aviação geral</span></div>"
			        & "<div class='mapbox'>" & _svg & "</div>"
			        & [HTML Voo Selecionado]
			        & "</div>"
		displayFolder: HTML
		lineageTag: bbc5c92c-e241-4980-b73b-b398750fb270

	measure 'HTML Painel Voos' =
			[HTML Estilo Voos]
			    & "<div class='pg'>"
			    & [HTML Cabecalho Voos]
			    & "<div class='main'>"
			    & "<div class='col' style='grid-template-rows:minmax(0,1.25fr) minmax(0,1fr)'>" & [HTML Companhias] & [HTML Fase Voo] & "</div>"
			    & [HTML Mapa Voos]
			    & "<div class='col' style='grid-template-rows:minmax(0,1fr) minmax(0,1fr)'>" & [HTML Serie Voos] & [HTML Mais Rapidos] & "</div>"
			    & "</div>"
			    & [HTML KPIs Voos]
			    & "</div>"
		displayFolder: HTML
		lineageTag: af5fdc7d-cdd7-4c89-bf7b-959afe7acd33

	/// 1 para posicoes dos ultimos 12 min (usar como filtro do visual Azure Maps: e 1)
	measure 'Ponto Recente' =
			VAR _ultUtc = CALCULATE ( MAX ( fato_posicoes[coleta_utc] ), REMOVEFILTERS ( fato_posicoes ) )
			RETURN
			    IF ( MAX ( fato_posicoes[coleta_utc] ) >= _ultUtc - 12 / 1440, 1 )
		formatString: 0
		displayFolder: Azure Maps
		lineageTag: 47e23c78-8253-4b6c-bed3-e4a67d93ab67

	/// Bolha maior na posicao atual, pequena no rastro
	measure 'Tamanho Bolha' =
			VAR _ultUtc = CALCULATE ( MAX ( fato_posicoes[coleta_utc] ), REMOVEFILTERS ( fato_posicoes ) )
			RETURN
			    IF ( MAX ( fato_posicoes[coleta_utc] ) = _ultUtc, 10, 1 )
		formatString: 0
		displayFolder: Azure Maps
		lineageTag: 1ffbf6b5-0678-4fce-a578-25c295e37e8d

	/// Card do mapa vazio para sobrepor o visual Azure Maps
	measure 'HTML Mapa Moldura' =
			"<div class='card map'><div class='ct'>Mapa ao vivo</div>"
			    & "<div class='sub'>cada avião aponta para a direção do voo · cor = fase do voo · use o scroll para dar zoom e arraste para mover</div>"
			    & "<div class='leg'><span><i class='sw' style='background:#38bdf8'></i>Cruzeiro</span><span><i class='sw' style='background:#f59e0b'></i>Descendo</span><span><i class='sw' style='background:#34d399'></i>Subindo</span><span><i class='sw' style='background:#64748b'></i>Em solo</span></div>"
			    & "<div class='mapbox'></div></div>"
		displayFolder: Azure Maps
		lineageTag: 0500bb79-ad97-41e8-9a11-5a7628c99b69

	/// Mesmo painel, com o centro livre para o visual Azure Maps
	measure 'HTML Painel Voos Azure' =
			[HTML Estilo Voos]
			    & "<div class='pg'>"
			    & [HTML Cabecalho Voos]
			    & "<div class='main'>"
			    & "<div class='col' style='grid-template-rows:minmax(0,1.25fr) minmax(0,1fr)'>" & [HTML Companhias] & [HTML Fase Voo] & "</div>"
			    & [HTML Mapa Moldura]
			    & "<div class='col' style='grid-template-rows:minmax(0,1fr) minmax(0,1fr)'>" & [HTML Serie Voos] & [HTML Mais Rapidos] & "</div>"
			    & "</div>"
			    & [HTML KPIs Voos]
			    & "</div>"
		displayFolder: Azure Maps
		lineageTag: e9a2ee54-c2ca-432e-932c-a3c5e5473673

	/// Tamanho fixo para o campo Tamanho do circulo do Icon Map Pro
	measure 'Tamanho Circulo' = IF ( NOT ISEMPTY ( posicao_atual ), 1 )
		formatString: 0
		displayFolder: Icon Map
		lineageTag: ebb558f2-df2c-4ba9-8f0f-c32495d311b5

	/// SVG do aviao (data URI) girado pela direcao e colorido pela fase do voo (mesmas cores da rosca Fase do voo)
	measure 'Icone Aviao' =
			VAR _dir = COALESCE ( MAX ( posicao_atual[direcao_graus] ), 0 )
			VAR _fase = SELECTEDVALUE ( posicao_atual[fase_voo] )
			VAR _cor =
			    SWITCH (
			        _fase,
			        "Cruzeiro", "#38bdf8",
			        "Descendo", "#f59e0b",
			        "Subindo", "#34d399",
			        "Em solo", "#64748b",
			        "#94a3b8"
			    )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='32' height='32' viewBox='-6 -6 12 12'>"
			        & "<path transform='rotate(" & FORMAT ( _dir, "0" ) & ")' d='M0 -5L1 -1.5L5 .7L5 1.7L1 .8L.7 3.5L2 4.6L2 5.2L0 4.6L-2 5.2L-2 4.6L-.7 3.5L-1 .8L-5 1.7L-5 .7L-1 -1.5Z' fill='"
			        & _cor & "' stroke='#0b1023' stroke-width='.35'/></svg>"
			// codifica para URL (data URI)
			VAR _url =
			    SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _svg,
			        "%", "%25" ), "<", "%3C" ), ">", "%3E" ), "#", "%23" ), " ", "%20" )
			RETURN
			    IF ( NOT ISEMPTY ( posicao_atual ), "data:image/svg+xml;charset=utf-8," & _url )
		displayFolder: Icon Map
		lineageTag: 4e23ae8d-6266-4f38-83f4-29eb0b1fb778
		dataCategory: ImageUrl

