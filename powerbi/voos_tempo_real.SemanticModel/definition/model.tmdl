model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["dim_companhia","fato_posicoes","posicao_atual","resumo_coleta"]

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

ref table dim_companhia
ref table fato_posicoes
ref table posicao_atual
ref table resumo_coleta
ref table 'Zoom Mapa'

ref cultureInfo pt-BR

